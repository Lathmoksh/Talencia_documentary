{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentra.internal/schemas/business-workflows.json",
  "title": "Talentra Business Workflow Analysis Schema",
  "description": "Validation schema for Talentra end-to-end operational lifecycles, state machines, decision gateways, and exception handling.",
  "type": "object",
  "required": [
    "metadata",
    "workflow_inventory",
    "state_machine_rules",
    "exception_catalogue",
    "feature_traceability"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["docket_id", "version", "last_updated", "author", "reviewed_by", "status"],
      "properties": {
        "docket_id": { "type": "string", "pattern": "^TAL-WF-[0-9]{4}$" },
        "version": { "type": "string" },
        "last_updated": { "type": "string", "format": "date" },
        "author": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Superseded"] }
      }
    },
    "workflow_inventory": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["workflow_code", "title", "trigger", "steps", "actors", "decisions", "exceptions", "outputs"],
        "properties": {
          "workflow_code": { "type": "string", "pattern": "^WF-[0-9]{2}$" },
          "title": { "type": "string" },
          "trigger": { "type": "string" },
          "steps": { "type": "array" },
          "actors": { "type": "array" },
          "decisions": { "type": "string" },
          "exceptions": { "type": "array" },
          "outputs": { "type": "string" }
        }
      }
    },
    "state_machine_rules": { "type": "array" },
    "exception_catalogue": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["exception_code", "failure_category", "failure_condition", "mitigation_strategy", "final_state"],
        "properties": {
          "exception_code": { "type": "string", "pattern": "^EXC-[0-9]{2}$" },
          "failure_category": { "type": "string", "enum": ["CANCEL_PATH", "REFUND_PATH", "RETRY_PATH", "TIMEOUT_PATH"] },
          "failure_condition": { "type": "string" },
          "mitigation_strategy": { "type": "string" },
          "final_state": { "type": "string" }
        }
      }
    },
    "feature_traceability": { "type": "array" }
  }
}
