{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentra.internal/schemas/feature-discovery.json",
  "title": "Talentra Feature Discovery Schema",
  "description": "Validation schema for Talentra feature catalog, competitive gap analysis, and MoSCoW prioritization.",
  "type": "object",
  "required": [
    "metadata",
    "competitor_gap_analysis",
    "feature_catalog",
    "database_mechanisms"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["docket_id", "version", "last_updated", "author", "reviewed_by", "status"],
      "properties": {
        "docket_id": { "type": "string", "pattern": "^TAL-FEAT-[0-9]{4}$" },
        "version": { "type": "string" },
        "last_updated": { "type": "string", "format": "date" },
        "author": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Superseded"] }
      }
    },
    "competitor_gap_analysis": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["dimension_name", "legacy_competitor_coverage", "talentra_implementation", "competitor_lack_argument"],
        "properties": {
          "dimension_name": { "type": "string" },
          "legacy_competitor_coverage": { "type": "string" },
          "talentra_implementation": { "type": "string" },
          "competitor_lack_argument": { "type": "string" }
        }
      }
    },
    "feature_catalog": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["feature_id", "title", "pillar", "moscow_priority", "mapped_requirements", "db_implementation_mechanism"],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^F-[0-9]{2}$" },
          "title": { "type": "string" },
          "pillar": { "type": "string", "enum": ["IDENTITY", "SOURCING", "MONETIZATION", "BILLING", "GIG", "GOVERNANCE"] },
          "moscow_priority": { "type": "string", "enum": ["Must-Have", "Should-Have", "Differentiator"] },
          "mapped_requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]{2}$" }
          },
          "db_implementation_mechanism": { "type": "string" }
        }
      }
    },
    "database_mechanisms": { "type": "object" }
  }
}
