{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentra.internal/schemas/business-workflows.json",
  "title": "Talentra Business Workflow Analysis Schema",
  "description": "Validation schema for Talentra end-to-end operational lifecycles, state machines, decision gateways, and exception handling.",
  "type": "object",
  "required": [
    "metadata",
    "workflow_inventory",
    "state_machine_rules",
    "exception_catalogue",
    "feature_traceability"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["docket_id", "version", "last_updated", "author", "reviewed_by", "status"],
      "properties": {
        "docket_id": { "type": "string", "pattern": "^TAL-WF-[0-9]{4}$" },
        "version": { "type": "string" },
        "last_updated": { "type": "string", "format": "date" },
        "author": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Superseded"] }
      }
    },
    "workflow_inventory": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["workflow_code", "title", "domain", "primary_actor", "trigger_event", "steps"],
        "properties": {
          "workflow_code": { "type": "string", "pattern": "^WF-[0-9]{2}$" },
          "title": { "type": "string" },
          "domain": { "type": "string", "enum": ["IDENTITY", "RECRUITMENT", "SOURCING", "GIG_MARKETPLACE", "LICENSING", "BILLING", "GOVERNANCE"] },
          "primary_actor": { "type": "string" },
          "trigger_event": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step_number", "step_name", "action_description"],
              "properties": {
                "step_number": { "type": "integer", "minimum": 1 },
                "step_name": { "type": "string" },
                "action_description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "state_machine_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_type", "state_from", "state_to", "is_allowed"],
        "properties": {
          "entity_type": { "type": "string", "enum": ["JOB_APPLICATION", "GIG_CONTRACT", "SUBSCRIPTION_LICENCE", "WALLET_ESCROW"] },
          "state_from": { "type": "string" },
          "state_to": { "type": "string" },
          "is_allowed": { "type": "boolean" },
          "guard_condition": { "type": "string" }
        }
      }
    },
    "exception_catalogue": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["exception_code", "failure_condition", "mitigation_strategy", "final_state"],
        "properties": {
          "exception_code": { "type": "string", "pattern": "^EXC-[0-9]{2}$" },
          "failure_condition": { "type": "string" },
          "mitigation_strategy": { "type": "string" },
          "final_state": { "type": "string" }
        }
      }
    },
    "feature_traceability": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["feature_id", "covered_in_workflows", "verification_status"],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^F-[0-9]{2}$" },
          "covered_in_workflows": {
            "type": "array",
            "items": { "type": "string", "pattern": "^WF-[0-9]{2}$" }
          },
          "verification_status": { "type": "string", "enum": ["VALIDATED", "PENDING"] }
        }
      }
    }
  }
}
