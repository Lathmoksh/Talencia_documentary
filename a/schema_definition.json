{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentra.internal/schemas/requirements-analysis-docket.json",
  "title": "Talentra Requirements Analysis Docket Schema",
  "description": "Validation schema for Talentra Phase 1 Discover Step 1 Requirements Analysis Docket, including 77 functional requirements, boundaries, measurable SLAs, open questions, and taxonomy architecture.",
  "type": "object",
  "required": [
    "metadata",
    "purpose",
    "problem_statement",
    "goals",
    "scope",
    "actors",
    "requirements_register",
    "vague_words_made_measurable",
    "assumptions",
    "ranked_open_questions",
    "coverage_check",
    "taxonomy_diagram",
    "gate_g1_scorecard"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["docket_id", "playbook_step", "version", "source_brief", "status"],
      "properties": {
        "docket_id": { "type": "string", "pattern": "^TAL-REQ-[0-9]{4}$" },
        "playbook_step": { "type": "string" },
        "version": { "type": "string" },
        "source_brief": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Frozen Baseline"] }
      }
    },
    "purpose": { "type": "string" },
    "problem_statement": {
      "type": "object",
      "required": ["background", "challenges", "scale_target"],
      "properties": {
        "background": { "type": "string" },
        "challenges": { "type": "array", "items": { "type": "string" } },
        "scale_target": {
          "type": "object",
          "required": ["candidates", "requirements", "applications"],
          "properties": {
            "candidates": { "type": "integer" },
            "requirements": { "type": "integer" },
            "applications": { "type": "integer" }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "goal", "measure_of_success"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+$" },
          "goal": { "type": "string" },
          "measure_of_success": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "item", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^OOS-[0-9]{2}$" },
              "item": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "actors": {
      "type": "object",
      "required": ["primary_actors", "edge_actors"],
      "properties": {
        "primary_actors": {
          "type": "array",
          "minItems": 9,
          "items": { "type": "string" }
        },
        "edge_actors": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string" }
        }
      }
    },
    "requirements_register": {
      "type": "object",
      "required": [
        "problem_and_goals",
        "job_categories",
        "gig_marketplace",
        "core_workflows",
        "actors_and_privileges",
        "data_domains",
        "data_standards",
        "integration_boundaries",
        "environment_and_scale",
        "deliverables"
      ],
      "properties": {
        "problem_and_goals": { "$ref": "#/$defs/reqList" },
        "job_categories": { "$ref": "#/$defs/reqList" },
        "gig_marketplace": { "$ref": "#/$defs/reqList" },
        "core_workflows": { "$ref": "#/$defs/reqList" },
        "actors_and_privileges": { "$ref": "#/$defs/reqList" },
        "data_domains": { "$ref": "#/$defs/reqList" },
        "data_standards": { "$ref": "#/$defs/reqList" },
        "integration_boundaries": { "$ref": "#/$defs/reqList" },
        "environment_and_scale": { "$ref": "#/$defs/reqList" },
        "deliverables": { "$ref": "#/$defs/reqList" }
      }
    },
    "vague_words_made_measurable": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["brief_wording", "proposed_number", "test_method"],
        "properties": {
          "brief_wording": { "type": "string" },
          "proposed_number": { "type": "string" },
          "test_method": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "assumption"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]+$" },
          "assumption": { "type": "string" }
        }
      }
    },
    "ranked_open_questions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["rank", "id", "question", "impact", "owner"],
        "properties": {
          "rank": { "type": "integer" },
          "id": { "type": "string", "pattern": "^Q[0-9]+$" },
          "question": { "type": "string" },
          "impact": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "coverage_check": {
      "type": "object",
      "required": ["gate_status", "brief_mappings"],
      "properties": {
        "gate_status": { "type": "string" },
        "brief_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["brief_section", "mapped_to"],
            "properties": {
              "brief_section": { "type": "string" },
              "mapped_to": { "type": "string" }
            }
          }
        }
      }
    },
    "taxonomy_diagram": {
      "type": "object",
      "required": ["image_path", "mermaid_available"],
      "properties": {
        "image_path": { "type": "string" },
        "mermaid_available": { "type": "boolean" }
      }
    },
    "gate_g1_scorecard": {
      "type": "object",
      "required": ["composite_score", "status", "dimensions"],
      "properties": {
        "composite_score": { "type": "number" },
        "status": { "type": "string" },
        "dimensions": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["dimension", "weight", "criteria", "observed", "score", "weighted_score"],
            "properties": {
              "dimension": { "type": "string" },
              "weight": { "type": "string" },
              "criteria": { "type": "string" },
              "observed": { "type": "string" },
              "score": { "type": "string" },
              "weighted_score": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reqList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
          "requirement": { "type": "string" },
          "source": { "type": "string" },
          "priority": { "type": "string", "enum": ["Must", "Should", "Could"] },
          "ambiguity_note": { "type": "string" }
        }
      }
    }
  }
}
